# ===== 推荐免费方案：智谱 GLM-4-Flash =====
# 1) 打开 https://open.bigmodel.cn  用手机号注册（实名即可）
# 2) 左侧「API 密钥」→ 创建 API Key
# 3) 把 key 填到下面 LLM_API_KEY，保存为 .env.llm 即可
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# ===== 备用：火山方舟（部分模型有免费额度/新用户额度）=====
# LLM_API_KEY=
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=你的推理接入点ID

# ===== 备用：硅基流动 SiliconFlow（注册送 2000 万 tokens）=====
# LLM_API_KEY=
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ===== 通用兼容 OpenAI =====
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
